.venv/
__pycache__/
# data/ исключается целиком, кроме набора оценки (часть B):
# JSONL лежат в DVC, в Git — только .dvc-указатели
data/*
!data/eval/
data/eval/*.jsonl
models/
# отчёты оценки коммитируются (задание: приложить отчёты, если metrics исключён)
metrics/*
!metrics/*.json
mlruns/
mlartifacts/
*.log
.DS_Store
.zcode/
